# Copy to .env and adjust. .env is git-ignored.
PORT=3000

# Postgres (docker-compose.yml publishes it on the host at DB_PORT)
DB_HOST=localhost
DB_PORT=5433
DB_USER=processflow
DB_PASSWORD=processflow
DB_NAME=processflow
# Max connections in the TypeORM/pg pool (tuned in Phase 2)
DB_POOL_MAX=10
# Log every SQL query (true/false)
DB_LOGGING=false

# Seed size (npm run seed). Raise SEED_CLAIMS if reports are too fast to show problems.
SEED_USERS=500
SEED_CLAIMS=100000

# Log one line per request (slows the API under load; keep false for benchmarks)
LOG_REQUESTS=false
